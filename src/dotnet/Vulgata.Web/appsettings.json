{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=vulgata;Username=vulgata;Password=vulgata_dev"
  },
  "Logging": {
    "LocalFile": {
      "Path": "logs/vulgata.log"
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PreparedPass2": {
