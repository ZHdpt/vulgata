@using Vulgata.Core.DomainServices
@using Vulgata.Shared.Repositories
@using Vulgata.Web.Components.Management.Databases
@using Vulgata.Web.Data
@if (Visible && Model is not null)
{
    <FluentDialog Visible="Visible" VisibleChanged="OnVisibleChanged" Title="仓库详情" PrimaryActionText="保存" SecondaryActionText="关闭"
                  PrimaryAction="@(async () => await SaveAsync())" SecondaryAction="CloseAsync">
        <div style="display:grid;gap:0.75rem">
            <div><strong>仓库名称：</strong>@Model.Name</div>
            <div>
                <FluentButton Appearance="Appearance.Accent" Disabled="@_isProfiling" OnClick="StartProfilingAsync">
                    @(_isProfiling ? "正在扫描…" : "开始扫描")
                </FluentButton>
            </div>

            @if (_profilingResult is not null)
            {
                <FluentMessageBar Severity="MessageSeverity.Success">
                    扫描完成：已解析 @_profilingResult.ParsedFileCount / @_profilingResult.TotalCandidateFileCount 个文件。
                    @if (_profilingResult.NeedsHumanReview)
                    {
                        <span>结果需要人工检查。</span>
                    }
                </FluentMessageBar>

                @if (_profilingResult.Languages.Count > 0)
                {
                    <div>
                        <strong>语言分布</strong>
                        <ul>
                            @foreach (ScanRunLanguageSummaryDto language in _profilingResult.Languages)
                            {
                                <li><code>@language.Language</code>：@language.DistinctFileCount 个文件</li>
                            }
                        </ul>
                    </div>
                }

                @if (_profilingResult.Frameworks.Count > 0)
                {
                    <div>
                        <strong>框架</strong>
                        <ul>
                            @foreach (ScanRunFrameworkSummaryDto framework in _profilingResult.Frameworks)
                            {
                                <li>
                                    <code>@framework.FrameworkName</code>：
                                    置信度 @LocalizeConfidence(framework.StrongestConfidence)，
                                    @framework.CodeUnitCount 个代码单元，
                                    @framework.TotalFactCount 条事实
                                    @if (framework.EvidenceSamples.Count > 0)
                                    {
                                        <ul>
                                            @foreach (FrameworkEvidenceSampleDto evidence in framework.EvidenceSamples)
                                            {
                                                <li>检测依据：<code>@evidence.DetectionSource</code></li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (_profilingResult.UnknownLanguage.DistinctFileCount > 0)
                {
                    <div>
                        <strong>未知语言文件</strong>：
                        @_profilingResult.UnknownLanguage.DistinctFileCount 个文件
                        <ul>
                            @foreach (string path in _profilingResult.UnknownLanguage.Paths)
                            {
                                <li><code>@path</code></li>
                            }
                        </ul>
                    </div>
                }

                @if (_profilingResult.FrameworkEvidenceAudit.TotalOutcomeCount > 0)
                {
                    <div>
                        <strong>框架证据警告</strong>：
                        @_profilingResult.FrameworkEvidenceAudit.SampledOutcomeCount /
                        @_profilingResult.FrameworkEvidenceAudit.TotalOutcomeCount
                        @if (_profilingResult.FrameworkEvidenceAudit.Details.Count > 0)
                        {
                            <ul>
                                @foreach (FrameworkEvidenceAuditDetailDto detail in
                                    _profilingResult.FrameworkEvidenceAudit.Details)
                                {
                                    <li><code>@detail.Path</code>：@detail.Outcome / @detail.Reason</li>
                                }
                            </ul>
                        }
                    </div>
                }
            }

            @if (_loadError is not null)
            {
                <FluentMessageBar Severity="MessageSeverity.Error">@_loadError</FluentMessageBar>
            }

            @if (_isLoading)
            {
                <FluentProgressRing />
            }
            else
            {
                <DatabaseConnectionPanel @ref="_databaseConnectionPanel"
                                         RepositoryId="Model.Id"
                                         Model="_databaseConnection"
                                         User="User"
                                         OnSaved="OnDatabaseConnectionSavedAsync"
                                         OnTestRequested="OnDatabaseConnectionTestRequestedAsync" />
            }
        </div>
    </FluentDialog>
}

@code {
    [Parameter]
    public RepositorySummaryDto? Model { get; set; }

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public IUserContext User { get; set; } = null!;

    [Parameter]
    public EventCallback<RepositorySummaryDto> OnSaved { get; set; }

    [Parameter]
    public EventCallback OnClosed { get; set; }

    [Inject]
    private IRepositoryDatabaseConnectionCoordinator DatabaseConnectionCoordinator { get; set; } = null!;

    [Inject]
    private IRepositoryProfilingCoordinator ProfilingCoordinator { get; set; } = null!;

    private DatabaseConnectionPanel? _databaseConnectionPanel;
    private RepositoryDatabaseConnectionSummaryDto? _databaseConnection;
    private bool _isLoading;
    private bool _isProfiling;
    private string? _loadError;
    private ScanRunSummaryDto? _profilingResult;
    private Guid _loadedRepositoryId;

    private static string LocalizeConfidence(string confidence) =>
        confidence switch
        {
            "High" => "高",
            "Medium" => "中",
            _ => "未知",
        };

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible || Model is null)
        {
            return;
        }

        if (_loadedRepositoryId != Model.Id)
        {
            _loadedRepositoryId = Model.Id;
            await LoadDatabaseConnectionAsync();
        }
    }

    private async Task LoadDatabaseConnectionAsync()
    {
        if (Model is null)
        {
            return;
        }

        _isLoading = true;
        _loadError = null;

        try
        {
            var result =
                await DatabaseConnectionCoordinator.GetAsync(Model.Id, User, CancellationToken.None);

            if (result.Outcome == RepositoryDatabaseConnectionMutationOutcome.Success && result.Value is not null)
            {
                _databaseConnection = result.Value;
            }
            else
            {
                _databaseConnection = new RepositoryDatabaseConnectionSummaryDto
                {
                    RepositoryId = Model.Id,
                    IsConfigured = false,
                    HasConnectionString = false,
                    HasUsername = false,
                    HasPassword = false,
                };
            }
        }
        catch (Exception)
        {
            _loadError = "加载数据库连接失败，请稍后重试。";
            _databaseConnection = new RepositoryDatabaseConnectionSummaryDto
            {
                RepositoryId = Model.Id,
                IsConfigured = false,
                HasConnectionString = false,
                HasUsername = false,
                HasPassword = false,
            };
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        // The dialog's primary "保存" action delegates to the embedded panel so the
        // single save path (validation -> coordinator -> refresh) stays in one place.
        if (_databaseConnectionPanel is not null)
        {
            await _databaseConnectionPanel.InvokeSaveAsync();
            return;
        }

        await OnSaved.InvokeAsync(Model);
    }

    private async Task OnDatabaseConnectionSavedAsync()
    {
        await LoadDatabaseConnectionAsync();
        await OnSaved.InvokeAsync(Model);
    }

    private Task OnDatabaseConnectionTestRequestedAsync()
    {
        return Task.CompletedTask;
    }

    private async Task StartProfilingAsync()
    {
        if (Model is null)
        {
            return;
        }

        _isProfiling = true;
        _loadError = null;
        _profilingResult = null;
        try
        {
            RepositoryProfilingResult result = Model.SystemId.HasValue
                ? await ProfilingCoordinator.StartSystemRepositoryAsync(
                    Model.SystemId.Value,
                    Model.Id,
                    User,
                    CancellationToken.None)
                : await ProfilingCoordinator.StartStandaloneRepositoryAsync(
                    Model.Id,
                    User,
                    CancellationToken.None);
            if (result.Outcome == RepositoryProfilingOutcome.Success)
            {
                _profilingResult = result.Value;
            }
            else
            {
                _loadError = result.Outcome switch
                {
                    RepositoryProfilingOutcome.RepositoryNotFound => "仓库不存在。",
                    RepositoryProfilingOutcome.GitFailure => "仓库克隆失败，请检查仓库地址和访问权限。",
                    RepositoryProfilingOutcome.ProviderUnavailable => "本地 CodeGraph 服务不可用，请联系管理员。",
                    RepositoryProfilingOutcome.ProviderFailure => "代码结构分析失败，请稍后重试。",
                    RepositoryProfilingOutcome.CandidateAuditBoundExceeded => "候选源文件审计范围超出限制。",
                    _ => "扫描失败，请稍后重试。",
                };
            }
        }
        catch (Exception)
        {
            _loadError = "扫描失败，请稍后重试。";
        }
        finally
        {
            _isProfiling = false;
        }
    }

    private async Task CloseAsync()
    {
        await OnVisibleChanged(false);
    }

    private async Task OnVisibleChanged(bool visible)
    {
        Visible = visible;
        if (!visible)
        {
            _loadedRepositoryId = Guid.Empty;
            _databaseConnection = null;
            _loadError = null;
            _profilingResult = null;
            await OnClosed.InvokeAsync();
        }
    }
}
