@using Vulgata.Shared.Repositories
@using Vulgata.Web.Data
@using SystemEntity = Vulgata.Core.Entities.System

@if (Systems.Count == 0)
{
    <p>尚未添加任何系统。创建你的第一个系统开始扫描。</p>
}
else
{
    @foreach (var system in Systems)
    {
        <section class="management-section management-subsection">
        <h2>@system.Name</h2>
        @if (!string.IsNullOrWhiteSpace(system.Description))
        {
            <p>@system.Description</p>
        }
        @if (IsAdministrator)
        {
            <div class="management-section-actions">
                <FluentButton Appearance="Appearance.Neutral" Size="Size.Small" OnClick="@(() => OnEditRequested.InvokeAsync(system))">编辑
                </FluentButton>
                <FluentButton Appearance="Appearance.Neutral" Size="Size.Small" OnClick="@(() => OnManageOwnersRequested.InvokeAsync(system))">管理所有者
                </FluentButton>
                <FluentButton Class="admin-danger-button" Appearance="Appearance.Neutral" Size="Size.Small" OnClick="@(() => OnDeleteRequested.InvokeAsync(system))">删除
                </FluentButton>
            </div>
        }

        <table class="table" aria-label="@system.Name 仓库列表">
            <thead>
                <tr>
                    <th scope="col">仓库名称</th>
                    <th scope="col">扫描状态</th>
                    <th scope="col">最后扫描时间</th>
                    <th scope="col">文档数量</th>
                    <th scope="col">扫描操作</th>
                    <th scope="col">查看</th>
                </tr>
            </thead>
            <tbody>
            @if (RepositoriesBySystem.TryGetValue(system.Id, out var repositories) && repositories.Count > 0)
                {
                    @foreach (var repository in repositories)
                    {
                        var demoState = GetDemoState(repository.Id);
                        <tr>
                            <td><span class="admin-code">@repository.Name</span></td>
                            <td><span class="admin-status-pill">@GetScanStatus(repository, demoState)</span></td>
                            <td>@GetLastScannedAt(repository, demoState)</td>
                            <td>@(demoState?.DocumentCount ?? repository.DocumentCount)</td>
                            <td>
                                <FluentButton Appearance="Appearance.Accent" Size="Size.Small"
                                              Disabled="@(demoState?.Phase == DemoRepositoryScanPhase.Scanning)"
                                              OnClick="@(() => OnScanRequested.InvokeAsync(repository.Id))">
                                    @(demoState?.Phase == DemoRepositoryScanPhase.Scanning ? "扫描中" : "开始扫描")
                                </FluentButton>
                            </td>
                            <td>
                                <FluentButton Appearance="Appearance.Neutral" Size="Size.Small"
                                              OnClick="@(() => OnViewAsync(repository.Id, demoState))">查看</FluentButton>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">暂无仓库</td>
                    </tr>
                }
            </tbody>
        </table>

        <FluentButton Appearance="Appearance.Accent" Size="Size.Small" OnClick="@(() => OnCreateRepositoryRequested.InvokeAsync(system))">+ 新建仓库</FluentButton>

        <SystemLlmOverridesPanel SystemId="system.Id"
                                 SystemName="system.Name"
                                 Overrides="@GetOverrides(system.Id)"
                                 OnOverrideAdded="@(() => OnLlmOverrideAdded.InvokeAsync(system.Id))"
                                 OnOverrideRemoved="@(overrideId => OnLlmOverrideRemoved.InvokeAsync((system.Id, overrideId)))" />
        </section>
    }
}

@code {
    [Parameter]
    public IReadOnlyList<SystemEntity> Systems { get; set; } = [];

    [Parameter]
    public IReadOnlyDictionary<Guid, IReadOnlyList<RepositorySummaryDto>> RepositoriesBySystem { get; set; }
        = new Dictionary<Guid, IReadOnlyList<RepositorySummaryDto>>();

    [Parameter]
    public IReadOnlyDictionary<Guid, DemoRepositoryScanSnapshot> DemoScanStates { get; set; }
        = new Dictionary<Guid, DemoRepositoryScanSnapshot>();

    [Parameter]
    public IReadOnlyDictionary<Guid, IReadOnlyList<SystemLlmProviderOverrideSummaryDto>> LlmOverridesBySystem { get; set; }
        = new Dictionary<Guid, IReadOnlyList<SystemLlmProviderOverrideSummaryDto>>();

    [Parameter]
    public bool IsAdministrator { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRepositorySelected { get; set; }

    [Parameter]
    public EventCallback<Guid> OnScanRequested { get; set; }

    [Parameter]
    public EventCallback<Guid> OnScanProgressSelected { get; set; }

    [Parameter]
    public EventCallback<SystemEntity> OnEditRequested { get; set; }

    [Parameter]
    public EventCallback<SystemEntity> OnManageOwnersRequested { get; set; }

    [Parameter]
    public EventCallback<SystemEntity> OnDeleteRequested { get; set; }

    [Parameter]
    public EventCallback<SystemEntity> OnCreateRepositoryRequested { get; set; }

    [Parameter]
    public EventCallback<Guid> OnLlmOverrideAdded { get; set; }

    [Parameter]
    public EventCallback<(Guid SystemId, Guid OverrideId)> OnLlmOverrideRemoved { get; set; }

    private IReadOnlyList<SystemLlmProviderOverrideSummaryDto> GetOverrides(Guid systemId)
    {
        return LlmOverridesBySystem.TryGetValue(systemId, out var overrides)
            ? overrides
            : [];
    }

    private DemoRepositoryScanSnapshot? GetDemoState(Guid repositoryId) =>
        DemoScanStates.TryGetValue(repositoryId, out var state) ? state : null;

    private static string GetScanStatus(
        RepositorySummaryDto repository,
        DemoRepositoryScanSnapshot? state) => state?.Phase switch
        {
            DemoRepositoryScanPhase.Ready => "待扫描",
            DemoRepositoryScanPhase.Scanning => "扫描中",
            DemoRepositoryScanPhase.Completed => "扫描完成",
            _ => repository.ScanStatus,
        };

    private static string GetLastScannedAt(
        RepositorySummaryDto repository,
        DemoRepositoryScanSnapshot? state) =>
        (state?.LastScannedAt ?? repository.LastScannedAt)?.ToString("yyyy-MM-dd HH:mm") ?? "-";

    private Task OnViewAsync(Guid repositoryId, DemoRepositoryScanSnapshot? state) =>
        state?.Phase == DemoRepositoryScanPhase.Scanning
            ? OnScanProgressSelected.InvokeAsync(repositoryId)
            : OnRepositorySelected.InvokeAsync(repositoryId);
}
