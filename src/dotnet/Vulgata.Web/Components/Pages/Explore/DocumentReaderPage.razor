@page "/knowledge/documents/read"
@attribute [Authorize]
@layout MainLayout
@implements IDisposable
@using Vulgata.Core.DomainServices.OctoberKnowledge
@using Vulgata.Web.Components.Explore
@using Vulgata.Web.ViewModels.Explore
@inject IServiceProvider Services

<PageTitle>文档阅读</PageTitle>
<div class="explore-reader" data-theme="light">
    <a href="/knowledge/documents">返回文档列表</a>
    <h1>文档阅读</h1>
    @if (_viewModel?.IsControlledFixture == true)
    {
        <p class="controlled-label">受控测试数据（非真实生成）</p>
    }
    @if (_viewModel is null)
    {
        <ExploreStatus LoadState="LoadState.Error" StatusText="文档阅读暂不可用。" />
    }
    else if (_parameterError is not null)
    {
        <ExploreStatus LoadState="LoadState.Error" StatusText="@_parameterError" />
    }
    else
    {
        <ExploreStatus LoadState="@_viewModel.LoadState" StatusText="@_viewModel.StatusText" />
        @if (_viewModel.Page?.Document is { } document)
        {
            <h2>@document.Title</h2>
            <p class="document-kind">@(document.Kind == DocumentKind.BusinessLogic ? "业务逻辑文档" : "代码逻辑文档")</p>
            <DocumentSections Page="@_viewModel.Page" Mode="@_viewModel.Mode" />
        }
        <div class="reader-actions" aria-label="阅读操作">
            @if (_viewModel.CanContinue)
            {
                <FluentButton id="next-chunk" OnClick="NextAsync">下一部分</FluentButton>
            }
            <FluentButton OnClick="RestartAsync" Disabled="@(_requestedHandle is null || _viewModel.LoadState == LoadState.Loading)">重新打开</FluentButton>
            @if (_viewModel.LoadState == LoadState.Loading)
            {
                <FluentButton OnClick="Cancel">取消</FluentButton>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "batch")] public string? Batch { get; set; }
    [SupplyParameterFromQuery(Name = "publication")] public string? Publication { get; set; }
    [SupplyParameterFromQuery(Name = "logical")] public string? Logical { get; set; }
    [SupplyParameterFromQuery(Name = "version")] public string? Version { get; set; }
    [SupplyParameterFromQuery(Name = "section")] public string? Section { get; set; }

    private DocumentReaderViewModel? _viewModel;
    private DocumentHandle? _requestedHandle;
    private string? _parameterError;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _viewModel = Services.GetService<DocumentReaderViewModel>();
        if (_viewModel is not null) { _viewModel.Changed += OnChanged; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_viewModel is null) { return; }
        if (!Guid.TryParse(Batch, out var batch) || !Guid.TryParse(Publication, out var publication) ||
            !Guid.TryParse(Logical, out var logical) || !Guid.TryParse(Version, out var version))
        {
            _requestedHandle = null;
            _viewModel.Clear();
            _parameterError = "文档链接无效。";
            return;
        }

        var handle = new DocumentHandle(batch, publication, logical, version, Section);
        if (!new Vulgata.Shared.Explore.ExploreDocumentHandleValidator().Validate(handle).IsValid)
        {
            _requestedHandle = null;
            _viewModel.Clear();
            _parameterError = "文档链接无效。";
            return;
        }

        _parameterError = null;
        if (_requestedHandle == handle) { return; }
        _requestedHandle = handle;
        await _viewModel.OpenAsync(handle);
    }

    private Task NextAsync() => _viewModel?.NextAsync() ?? Task.CompletedTask;
    private Task RestartAsync() => _viewModel is not null && _requestedHandle is not null
        ? _viewModel.OpenAsync(_requestedHandle) : Task.CompletedTask;
    private void Cancel() => _viewModel?.Cancel();
    private void OnChanged()
    {
        if (!_disposed) { _ = InvokeAsync(() => { if (!_disposed) { StateHasChanged(); } }); }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_viewModel is not null)
        {
            _viewModel.Changed -= OnChanged;
            _viewModel.Dispose();
        }
    }
}
