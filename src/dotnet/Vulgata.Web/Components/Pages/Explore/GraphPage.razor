@page "/knowledge/graph"
@attribute [Authorize]
@layout MainLayout
@implements IDisposable
@using Vulgata.Core.DomainServices.OctoberKnowledge
@using Vulgata.Web.Components.Explore
@using Vulgata.Web.ViewModels.Explore
@inject IServiceProvider Services

<PageTitle>知识图谱</PageTitle>
<div class="explore-graph-page" data-theme="@(_viewModel?.Mode == KnowledgeMode.IT ? "dark" : "light")">
    <a href="/knowledge/documents">返回文档列表</a>
    <h1>知识图谱</h1>
    @if (_viewModel is null)
    {
        <ExploreStatus LoadState="LoadState.Error" StatusText="知识图谱暂不可用。" />
    }
    else
    {
        @if (_viewModel.IsControlledFixture)
        {
            <p class="controlled-label">受控测试数据（非真实生成）</p>
        }
        <ExploreStatus LoadState="@_viewModel.LoadState" StatusText="@_viewModel.StatusText" />
        <div class="graph-page-actions">
            <FluentButton aria-label="手动刷新" OnClick="RefreshAsync" Disabled="@IsLoading">手动刷新</FluentButton>
            @if (IsLoading)
            {
                <FluentButton aria-label="取消" OnClick="Cancel">取消</FluentButton>
            }
        </div>
        @if (_viewModel.Graph is not null)
        {
            <KnowledgeGraph Graph="@_viewModel.Graph" Mode="@_viewModel.Mode" />
        }
    }
</div>

@code {
    private KnowledgeGraphViewModel? _viewModel;
    private bool _disposed;
    private bool IsLoading => _viewModel?.LoadState is LoadState.Loading or LoadState.Refreshing;

    protected override async Task OnInitializedAsync()
    {
        _viewModel = Services.GetService<KnowledgeGraphViewModel>();
        if (_viewModel is not null)
        {
            _viewModel.Changed += OnChanged;
            await _viewModel.LoadAsync();
        }
    }

    private Task RefreshAsync() => _viewModel?.RefreshAsync() ?? Task.CompletedTask;
    private void Cancel() => _viewModel?.Cancel();
    private void OnChanged()
    {
        if (!_disposed) { _ = InvokeAsync(() => { if (!_disposed) { StateHasChanged(); } }); }
    }

    public void Dispose()
    {
        _disposed = true;
        if (_viewModel is not null)
        {
            _viewModel.Changed -= OnChanged;
            _viewModel.Dispose();
        }
    }
}
