@page "/knowledge/documents"
@attribute [Authorize]
@layout MainLayout
@implements IAsyncDisposable
@inject IJSRuntime JS
@using Vulgata.Core.DomainServices.OctoberKnowledge
@using Vulgata.Web.Components.Explore
@using Vulgata.Web.Explore
@using Vulgata.Web.ViewModels.Explore
@inject IServiceProvider Services

<PageTitle>文档列表</PageTitle>
<div @ref="_root" class="explore-documents" data-theme="light">
    <h1>文档列表</h1>
    @if (_viewModel?.IsControlledFixture == true)
    {
        <p class="controlled-label">受控测试数据（非真实生成）</p>
    }
    @if (_viewModel is null)
    {
        <ExploreStatus LoadState="LoadState.Error" StatusText="文档列表暂不可用。" />
    }
    else
    {
        <form class="document-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <label for="document-title-search">按标题搜索</label>
            <input id="document-title-search" type="search" placeholder="输入文档标题…" @bind="_query" @bind:event="oninput" />
            <FluentButton Type="ButtonType.Submit" Disabled="@(_viewModel.LoadState == LoadState.Loading)">搜索</FluentButton>
        </form>
        <ExploreStatus LoadState="@_viewModel.LoadState" StatusText="@_viewModel.StatusText" />
        <ul class="document-list" aria-label="可读取的文档">
            @if (_viewModel.Page is { Documents.IsDefaultOrEmpty: false } page)
            {
                @foreach (var document in page.Documents)
                {
                    <li><a title="@document.Title" href="@ExactDocumentLinkBuilder.Build(document.Handle)">@document.Title</a></li>
                }
            }
            else
            {
                <li class="page-size-probe" aria-hidden="true"><a>文档标题</a></li>
            }
        </ul>
        <div class="browse-actions" aria-label="列表操作">
            <FluentButton OnClick="PreviousAsync" Disabled="@(!_viewModel.CanPrevious)">上一页</FluentButton>
            @{ var previousPage = 0; }
            @foreach (var number in VisiblePages)
            {
                var target = number;
                @if (target > previousPage + 1)
                {
                    <span class="pagination-ellipsis" aria-label="省略的页码">…</span>
                }
                previousPage = target;
                <FluentButton aria-label="@($"第 {target} 页")" aria-current="@(target == _viewModel.PageNumber ? "page" : null)"
                              Appearance="@(target == _viewModel.PageNumber ? Appearance.Accent : Appearance.Neutral)"
                              Disabled="@(_viewModel.LoadState == LoadState.Loading)" OnClick="() => _viewModel.GoToPageAsync(target)">@target</FluentButton>
            }
            <span class="page-number" aria-live="polite">第 @(_viewModel.TotalPages == 0 ? 0 : _viewModel.PageNumber) / @_viewModel.TotalPages 页 · 共 @_viewModel.TotalItems 条</span>
            <FluentButton OnClick="NextAsync" Disabled="@(!_viewModel.CanContinue)">下一页</FluentButton>
            <form class="page-jump" @onsubmit="JumpAsync" @onsubmit:preventDefault>
                <label for="document-page">跳至</label>
                <input id="document-page" type="number" min="1" max="@_viewModel.TotalPages" @bind="_jumpPage" aria-label="跳转页码" />
                <FluentButton Type="ButtonType.Submit" Disabled="@(_viewModel.TotalPages == 0 || _viewModel.LoadState == LoadState.Loading)">跳转</FluentButton>
            </form>
            <FluentButton OnClick="ReloadAsync" Disabled="@(_viewModel.LoadState == LoadState.Loading)">重新加载</FluentButton>
            @if (_viewModel.LoadState == LoadState.Loading)
            {
                <FluentButton OnClick="Cancel">取消</FluentButton>
            }
        </div>
    }
</div>

@code {
    private DocumentBrowseViewModel? _viewModel;
    private bool _disposed;
    private string _query = "";
    private int _jumpPage = 1;
    private IEnumerable<int> VisiblePages => _viewModel is null || _viewModel.TotalPages == 0 ? [] :
        Enumerable.Range(Math.Max(1, Math.Min(_viewModel.PageNumber - 2, _viewModel.TotalPages - 4)), Math.Min(5, _viewModel.TotalPages))
            .Prepend(1).Append(_viewModel.TotalPages).Distinct().Order();
    private Task JumpAsync() => _viewModel?.GoToPageAsync(_jumpPage) ?? Task.CompletedTask;
    private Task SearchAsync() => _viewModel?.SearchAsync(_query) ?? Task.CompletedTask;
    private Task PreviousAsync() => _viewModel?.PreviousAsync() ?? Task.CompletedTask;

    private ElementReference _root;
    private IJSObjectReference? _module;
    private bool _initialSizingStarted;

    protected override void OnInitialized()
    {
        _viewModel = Services.GetService<DocumentBrowseViewModel>();
        if (_viewModel is not null) _viewModel.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_viewModel is null || _initialSizingStarted || _disposed) return;
        _initialSizingStarted = true;
        await ReloadAsync();
    }

    private async Task<int> MeasurePageSizeAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Explore/DocumentsPage.razor.js");
            var count = await _module.InvokeAsync<int>("measurePageSize", _root);
            return count > 0 ? count : KnowledgeContract.DefaultPageSize;
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            return _viewModel?.PageSize ?? KnowledgeContract.DefaultPageSize;
        }
    }

    private Task NextAsync() => _viewModel?.NextAsync() ?? Task.CompletedTask;
    private async Task ReloadAsync()
    {
        var size = await MeasurePageSizeAsync();
        if (!_disposed && _viewModel is not null) await _viewModel.LoadAsync(size);
    }
    private void Cancel() => _viewModel?.Cancel();
    private void OnChanged()
    {
        if (!_disposed) { _ = InvokeAsync(() => { if (!_disposed) { StateHasChanged(); } }); }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_viewModel is not null)
        {
            _viewModel.Changed -= OnChanged;
            _viewModel.Dispose();
        }
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
