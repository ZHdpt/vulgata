@page "/"
@attribute [Authorize]
@inject PreparedChatCoordinator ChatCoordinator
@using Vulgata.Core.DomainServices
@using Vulgata.Web.Data
@implements IDisposable

<PageTitle>对话</PageTitle>

<div class="chat-page @PageModeClass @ConversationStateClass" data-theme="@ThemeName" data-load-state="@_loadState">
    <EditForm EditContext="_editContext" OnValidSubmit="SendAsync" OnInvalidSubmit="HandleInvalidSubmit">
        <FluentValidationValidator />
    <section class="chat-controls" aria-label="准备提问">
        <div class="chat-controls__topbar">
            <fieldset class="mode-selector">
                <legend class="visually-hidden">选择对话模式</legend>
                <FluentButton Appearance="@ModeAppearance(ChatMode.Business)"
                              Type="ButtonType.Button"
                              Disabled="@_isBusy"
                              aria-pressed="@ModeAriaPressed(ChatMode.Business)"
                              @onclick="() => SelectMode(ChatMode.Business)">业务模式</FluentButton>
                <FluentButton Appearance="@ModeAppearance(ChatMode.It)"
                              Type="ButtonType.Button"
                              Disabled="@_isBusy"
                              aria-pressed="@ModeAriaPressed(ChatMode.It)"
                              @onclick="() => SelectMode(ChatMode.It)">技术模式</FluentButton>
            </fieldset>

            <FluentButton Class="new-conversation-button"
                          Appearance="Appearance.Stealth"
                          Type="ButtonType.Button"
                          aria-label="开始新对话"
                          @onclick="StartNewConversationAsync"><span aria-hidden="true">＋</span> 新对话</FluentButton>
        </div>

        <div class="scope-selector">
            <label for="chat-system">系统</label>
            <select id="chat-system"
                    value="@(_selectedSystemId?.ToString() ?? string.Empty)"
                    disabled="@(_loadState != LoadState.Loaded || _isBusy)"
                    @onchange="OnSystemChanged">
                <option value="">请选择系统</option>
                @foreach (var scope in _scopes)
                {
                    <option value="@scope.SystemId">@scope.SystemDisplayName</option>
                }
            </select>

            <label for="chat-repository-first">仓库一</label>
            <select id="chat-repository-first"
                    value="@(_firstRepositoryId?.ToString() ?? string.Empty)"
                    disabled="@(_selectedSystemId is null || _isBusy)"
                    @onchange="OnFirstRepositoryChanged">
                <option value="">请选择第一个仓库</option>
                @foreach (var repository in SelectedRepositories)
                {
                    <option value="@repository.RepositoryId">@repository.DisplayName</option>
                }
            </select>

            <label for="chat-repository-second">仓库二</label>
            <select id="chat-repository-second"
                    value="@(_secondRepositoryId?.ToString() ?? string.Empty)"
                    disabled="@(_selectedSystemId is null || _isBusy)"
                    @onchange="OnSecondRepositoryChanged">
                <option value="">请选择第二个仓库</option>
                @foreach (var repository in SelectedRepositories)
                {
                    <option value="@repository.RepositoryId">@repository.DisplayName</option>
                }
            </select>
        </div>
    </section>

    <section class="chat-surface" aria-live="polite" aria-busy="@(_isBusy ? "true" : "false")">
        @if (_submittedQuestion is not null)
        {
            <div class="chat-message chat-message--user">@_submittedQuestion</div>
        }

        @if (_answer is not null)
        {
            <article class="chat-message chat-message--assistant complete-answer" data-answer-state="complete">
                @foreach (MaterialClaim claim in _answer.MaterialClaims)
                {
                    <section class="answer-claim">
                        <p class="material-claim">@claim.Text</p>
                        @foreach (DocumentCitation citation in _answer.DocumentCitations.Where(
                            citation => claim.CitationIds.Contains(citation.CitationId, StringComparer.Ordinal)))
                        {
                            <div class="document-citation"
                                 data-repository-relative-path="@citation.RepositoryRelativePath"
                                 data-line-start="@citation.LineStart"
                                 data-line-end="@citation.LineEnd">
                                <span class="document-citation__title">文档引用：@citation.DocumentTitle</span>
                                @if (_answer.Mode == ChatMode.It)
                                {
                                    <span class="citation-locator citation-locator--inline">@citation.RepositoryDisplayName · @citation.RepositoryRelativePath · 第 @citation.LineStart–@citation.LineEnd 行</span>
                                }
                                else
                                {
                                    <details class="document-citation__details">
                                        <summary><span>查看来源</span><span class="citation-chevron" aria-hidden="true">⌄</span></summary>
                                        <span class="citation-locator">@citation.RepositoryDisplayName · @citation.RepositoryRelativePath · 第 @citation.LineStart–@citation.LineEnd 行</span>
                                    </details>
                                }
                            </div>
                        }
                    </section>
                }
            </article>
        }
        else if (_isBusy)
        {
            <div class="chat-thinking" role="status">
                <span class="chat-thinking__spark" aria-hidden="true">✦</span>
                <span class="chat-thinking__copy">
                    <span>@ActiveStatusMessage</span>
                    <small>AI 正在分析跨仓库上下文</small>
                </span>
                <span class="chat-thinking__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            </div>
        }
        else if (_submittedQuestion is null)
        {
            <div class="chat-welcome">
                <h1 class="display-serif display-serif-lg">@WelcomeMessage</h1>
                <p>请选择一个系统及其两个仓库，然后输入问题。</p>
            </div>
        }

        @if (_message is not null)
        {
            @if (_loadState == LoadState.Empty)
            {
                <p class="chat-message chat-message--assistant" data-answer-state="unsupported">@_message</p>
            }
            else
            {
                <p class="chat-message chat-message--status" role="alert">@_message</p>
            }
        }

        @if (_conversationNotice is not null)
        {
            <p class="conversation-notice" role="status">@_conversationNotice</p>
        }
    </section>

    <section class="question-composer" aria-label="问题输入">
        <label class="visually-hidden" for="chat-question">问题</label>
        <textarea id="chat-question"
                  @ref="_questionElement"
                  value="@_question"
                  placeholder="@QuestionPlaceholder"
                  aria-label="@QuestionPlaceholder"
                  autocomplete="off"
                  rows="3"
                  readonly="@_isBusy"
                  @oninput="OnQuestionInput"
                  @onkeydown="HandleQuestionKeyDownAsync"></textarea>
        @if (_isBusy)
        {
            <FluentButton Class="composer-action composer-action--cancel" Appearance="Appearance.Neutral" @onclick="CancelRequest">取消</FluentButton>
        }
        else
        {
            <FluentButton Class="primary-button composer-action" Appearance="Appearance.Accent" Type="ButtonType.Submit">发送 <span aria-hidden="true">↗</span></FluentButton>
        }
    </section>
    </EditForm>
</div>
