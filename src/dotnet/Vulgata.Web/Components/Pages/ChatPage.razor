@page "/"
@attribute [Authorize]
@inject PreparedChatCoordinator ChatCoordinator
@inject IChatRevealDelay RevealDelay
@inject IJSRuntime JsRuntime
@using Vulgata.Core.DomainServices
@using Vulgata.Web.Data
@implements IAsyncDisposable

<PageTitle>对话</PageTitle>

<div class="chat-page @PageModeClass @ConversationStateClass" data-theme="@ThemeName" data-load-state="@_loadState">
    <EditForm class="chat-page__form" EditContext="_editContext" OnValidSubmit="SendAsync" OnInvalidSubmit="HandleInvalidSubmit">
        <FluentValidationValidator />
    <section class="chat-controls" aria-label="准备提问">
        <div class="chat-controls__topbar">
            <fieldset class="mode-selector">
                <legend class="visually-hidden">选择对话模式</legend>
                <FluentButton Appearance="@ModeAppearance(ChatMode.Business)"
                              Type="ButtonType.Button"
                              Disabled="@_isBusy"
                              aria-pressed="@ModeAriaPressed(ChatMode.Business)"
                              @onclick="() => SelectMode(ChatMode.Business)">业务模式</FluentButton>
                <FluentButton Appearance="@ModeAppearance(ChatMode.It)"
                              Type="ButtonType.Button"
                              Disabled="@_isBusy"
                              aria-pressed="@ModeAriaPressed(ChatMode.It)"
                              @onclick="() => SelectMode(ChatMode.It)">技术模式</FluentButton>
            </fieldset>

            <FluentButton Class="new-conversation-button"
                          Appearance="Appearance.Stealth"
                          Type="ButtonType.Button"
                          aria-label="开始新对话"
                          @onclick="StartNewConversationAsync"><span aria-hidden="true">＋</span> 新对话</FluentButton>
        </div>

    </section>

    <section class="chat-surface"
             aria-label="对话记录"
             aria-live="polite"
             aria-busy="@(_isBusy ? "true" : "false")"
             tabindex="0">
        @foreach (ChatTurn turn in _turns)
        {
            <div class="chat-turn" data-chat-turn="@turn.Id">
                <div class="chat-message chat-message--user">@turn.Question</div>

                @if (turn.State is ChatTurnState.Revealing or ChatTurnState.Complete && turn.Answer is not null)
                {
                    <article class="chat-message chat-message--assistant complete-answer"
                             data-answer-state="@(turn.State == ChatTurnState.Complete ? "complete" : "revealing")"
                             aria-live="@(turn.State == ChatTurnState.Revealing ? "off" : null)">
                        @foreach (ChatClaimReveal claim in turn.Claims)
                        {
                            <section class="answer-claim" data-claim-complete="@claim.IsComplete.ToString().ToLowerInvariant()">
                                <p class="material-claim" aria-label="@claim.Claim.Text">
                                    <span class="material-claim__revealed" aria-hidden="true">
                                        @for (int elementIndex = 0; elementIndex < claim.VisibleTextElements.Count; elementIndex++)
                                        {
                                            string textElement = claim.VisibleTextElements[elementIndex];
                                            <span class="material-claim__element" @key="elementIndex">@textElement</span>
                                        }
                                    </span>
                                </p>
                                @if (claim.IsComplete)
                                {
                                    @foreach (DocumentCitation citation in turn.Answer.DocumentCitations.Where(
                                        citation => claim.Claim.CitationIds.Contains(citation.CitationId, StringComparer.Ordinal)))
                                    {
                                        <div class="document-citation"
                                             data-repository-relative-path="@citation.RepositoryRelativePath"
                                             data-line-start="@citation.LineStart"
                                             data-line-end="@citation.LineEnd">
                                            <span class="document-citation__title">文档引用：@citation.DocumentTitle</span>
                                            @if (turn.Answer.Mode == ChatMode.It)
                                            {
                                                <span class="citation-locator citation-locator--inline">@citation.RepositoryDisplayName · @citation.RepositoryRelativePath · 第 @citation.LineStart–@citation.LineEnd 行</span>
                                            }
                                            else
                                            {
                                                <details class="document-citation__details">
                                        <summary><span>查看来源</span><span class="citation-chevron" aria-hidden="true"></span></summary>
                                                    <span class="citation-locator">@citation.RepositoryDisplayName · @citation.RepositoryRelativePath · 第 @citation.LineStart–@citation.LineEnd 行</span>
                                                </details>
                                            }
                                        </div>
                                    }
                                }
                            </section>
                        }
                    </article>
                }
                else if (turn.State == ChatTurnState.Pending)
                {
                    <div class="chat-thinking" role="status">
                        <span class="chat-thinking__spark" aria-hidden="true">✦</span>
                        <span class="chat-thinking__copy">
                            <span>@ActiveStatusMessage</span>
                            <small>AI 正在分析跨仓库上下文</small>
                        </span>
                        <span class="chat-thinking__dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    </div>
                }
                else if (turn.Message is not null)
                {
                    <p class="chat-message chat-message--assistant" data-answer-state="unsupported">@turn.Message</p>
                }
            </div>
        }

        @if (_turns.Count == 0)
        {
            <div class="chat-welcome">
                <h1 class="display-serif display-serif-lg">@WelcomeMessage</h1>
                <p>选择相关仓库，然后输入你想了解的问题。</p>
            </div>
        }

        @if (_message is not null)
        {
            @if (_loadState == LoadState.Empty)
            {
                <p class="chat-message chat-message--assistant" data-answer-state="unsupported">@_message</p>
            }
            else
            {
                <p class="chat-message chat-message--status" role="alert">@_message</p>
            }
        }

        @if (_conversationNotice is not null)
        {
            <p class="conversation-notice" role="status">@_conversationNotice</p>
        }
    </section>

    <section class="question-composer" aria-label="问题输入">
        <label class="visually-hidden" for="chat-question">问题</label>
        <textarea id="chat-question"
                  @ref="_questionElement"
                  @bind="_question"
                  @bind:event="oninput"
                  @bind:after="OnQuestionChanged"
                  placeholder="@QuestionPlaceholder"
                  aria-label="@QuestionPlaceholder"
                  autocomplete="off"
                  rows="3"
                  readonly="@_isBusy"
                  @onkeydown="HandleQuestionKeyDownAsync"></textarea>
        <div class="composer-context-row">
            <div class="repository-picker" @onkeydown="HandleRepositoryPickerKeyDown">
                <button class="@RepositoryPickerTriggerClass"
                        type="button"
                        aria-label="选择仓库"
                        aria-haspopup="menu"
                        aria-expanded="@(_isRepositoryPickerOpen ? "true" : "false")"
                        @onclick="ToggleRepositoryPicker"><span aria-hidden="true">＋</span></button>

                <div class="repository-chips" aria-label="已选择的仓库">
                    @foreach (string repositoryName in _selectedUiRepositories)
                    {
                        <span class="repository-chip" data-repository-name="@repositoryName" @key="repositoryName">
                            <span class="repository-chip__status" aria-hidden="true"></span>
                            <span class="repository-chip__name">@repositoryName</span>
                            <button class="repository-chip__remove"
                                    type="button"
                                    aria-label="移除 @repositoryName"
                                    @onclick="() => RemoveUiRepository(repositoryName)">×</button>
                        </span>
                    }
                </div>

                @if (_isRepositoryPickerOpen)
                {
                    <button class="repository-picker__dismiss" type="button" aria-label="关闭仓库选择器" @onclick="CloseRepositoryPicker"></button>
                    <div class="repository-menu" role="menu" aria-label="选择仓库">
                        <div class="repository-menu__systems">
                            @foreach (DemoRepositorySystem system in DemoRepositoryCatalog)
                            {
                                <button class="repository-menu__system"
                                        type="button"
                                        role="menuitem"
                                        data-system-id="@system.Id"
                                        aria-expanded="@(system.Id == _activeRepositorySystemId ? "true" : "false")"
                                        @onmouseenter="() => ActivateRepositorySystem(system.Id)"
                                        @onfocus="() => ActivateRepositorySystem(system.Id)"
                                        @onclick="() => ActivateRepositorySystem(system.Id)">
                                    <span>@system.Name</span><span class="repository-menu__chevron" aria-hidden="true">›</span>
                                </button>
                            }
                        </div>

                        @if (ActiveRepositorySystem is not null)
                        {
                            <div class="repository-menu__repositories" role="group" aria-label="@($"{ActiveRepositorySystem.Name} 仓库")">
                                @foreach (string repositoryName in ActiveRepositorySystem.Repositories)
                                {
                                    bool isSelected = _selectedUiRepositories.Contains(repositoryName);
                                    <button class="repository-menu__repository"
                                            type="button"
                                            data-repository-name="@repositoryName"
                                            role="menuitemcheckbox"
                                            aria-checked="@(isSelected ? "true" : "false")"
                                            @onclick="() => ToggleUiRepository(repositoryName)">
                                        <span class="repository-menu__check" aria-hidden="true">✓</span>
                                        <span>@repositoryName</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @if (_isBusy)
            {
                <FluentButton Class="composer-action composer-action--cancel" Appearance="Appearance.Neutral" @onclick="CancelRequest">取消</FluentButton>
            }
            else
            {
                <FluentButton Class="primary-button composer-action" Appearance="Appearance.Accent" Type="ButtonType.Submit">发送</FluentButton>
            }
        </div>
    </section>
    </EditForm>
</div>
