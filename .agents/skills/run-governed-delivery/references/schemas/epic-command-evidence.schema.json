{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:governed-delivery:workflow:epic-command-evidence:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "kind", "stage", "source_commit", "artifact_paths", "command", "exit_code", "observed_at", "summary", "raw_output_path", "raw_output_sha256", "execution_worktree", "execution_worktree_head", "execution_worktree_git_identity", "boundary_clean", "source_equality_validated_at", "environment_summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_id": {"type": "string", "pattern": "^[^/]+/[^/]+/[1-9][0-9]*$"},
    "kind": {"const": "command"},
    "stage": {"enum": ["verify-build", "verify-test"]},
    "source_commit": {"$ref": "#/$defs/sha"},
    "artifact_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/repoPath"}},
    "command": {"type": "string", "minLength": 1},
    "exit_code": {"const": 0},
    "observed_at": {"$ref": "#/$defs/time"},
    "summary": {"type": "string", "minLength": 1},
    "raw_output_path": {"$ref": "#/$defs/repoPath"},
    "raw_output_sha256": {"$ref": "#/$defs/hash"},
    "execution_worktree": {"type": "string", "minLength": 1},
    "execution_worktree_head": {"$ref": "#/$defs/sha"},
    "execution_worktree_git_identity": {"type": "string", "minLength": 1},
    "boundary_clean": {"const": true},
    "source_equality_validated_at": {"$ref": "#/$defs/time"},
    "environment_summary": {"type": "string", "minLength": 1}
  },
  "allOf": [{"properties": {"boundary_clean": {"const": true}}}],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "repoPath": {"type": "string", "minLength": 1, "not": {"pattern": "^(?:[A-Za-z]:|/|\\\\|.*(?:^|[\\/])\\.\\.(?:[\\/]|$))"}}
  }
}
