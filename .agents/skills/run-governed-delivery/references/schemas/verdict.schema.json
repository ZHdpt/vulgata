{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-delivery.local/schemas/verdict.schema.json",
  "title": "Governed Delivery Verdict",
  "type": "object",
  "required": [
    "schema_version",
    "gate",
    "verdict",
    "reviewed_commit",
    "reviewed_boundary",
    "reviewed_artifacts",
    "findings",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "gate": {
      "enum": [
        "plan-review",
        "definition-review",
        "quality-review"
      ]
    },
    "verdict": {
      "enum": [
        "ACCEPT",
        "REVISE",
        "BLOCKED"
      ]
    },
    "reviewed_commit": {
      "$ref": "#/$defs/commit"
    },
    "reviewed_boundary": {
      "$ref": "#/$defs/boundary"
    },
    "reviewed_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "boundary": {
      "type": "object",
      "required": [
        "base_commit",
        "candidate_commit",
        "diff_sha256",
        "artifact_hashes",
        "owned_paths"
      ],
      "properties": {
        "base_commit": {
          "$ref": "#/$defs/commit"
        },
        "candidate_commit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/commit"
            }
          ]
        },
        "diff_sha256": {
          "$ref": "#/$defs/hash"
        },
        "artifact_hashes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/path"
          },
          "additionalProperties": {
            "$ref": "#/$defs/hash"
          }
        },
        "owned_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "category",
        "artifact",
        "location",
        "affected_requirement",
        "evidence",
        "correction_outcome",
        "earliest_owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/path"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "affected_requirement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "correction_outcome": {
          "type": "string",
          "minLength": 1
        },
        "earliest_owner": {
          "enum": [
            "spec",
            "plan",
            "tasks",
            "implement"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "ACCEPT"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "properties": {
                  "severity": {
                    "enum": [
                      "CRITICAL",
                      "HIGH"
                    ]
                  }
                },
                "required": [
                  "severity"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "REVISE"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "severity": {
                  "enum": [
                    "CRITICAL",
                    "HIGH"
                  ]
                }
              },
              "required": [
                "severity"
              ]
            }
          }
        }
      }
    }
  ]
}
