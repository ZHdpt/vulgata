{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulgata.local/contracts/story125-evaluation-case.schema.json",
  "title": "Story 12.5 Chat Evaluation Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "sourceAuthorities", "cases"],
  "properties": {
    "schemaVersion": { "const": "story125-chat-evaluation/1.0" },
    "corpusId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "sourceAuthorities": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "systemAlias", "repositoryAliases", "question", "followUpTo", "expectedEvidenceThemes", "expectedRelationshipKinds", "usefulAnswerCriteria", "citationExpectation", "authorizationExpectation", "observation"],
      "properties": {
        "id": { "type": "string", "pattern": "^q[0-9]{2}$" },
        "mode": { "enum": ["business", "it"] },
        "systemAlias": { "type": "string", "minLength": 1, "maxLength": 64 },
        "repositoryAliases": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "followUpTo": { "oneOf": [{ "type": "string", "pattern": "^q[0-9]{2}$" }, { "type": "null" }] },
        "expectedEvidenceThemes": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "expectedRelationshipKinds": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["references", "generatedFrom", "exactCrossRepository", "flowGroup", "none"] } },
        "usefulAnswerCriteria": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "citationExpectation": { "enum": ["required", "insufficientEvidenceExpected"] },
        "authorizationExpectation": { "enum": ["authorized", "missingEquivalent", "noRestrictedDisclosure"] },
        "observation": { "$ref": "#/$defs/observation" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "durationMilliseconds", "packetFingerprint", "answerFingerprint", "useful", "allAcceptedTechnicalClaimsCited", "unauthorizedDisclosure", "limitation"],
      "properties": {
        "status": { "enum": ["planned", "attempted", "passed", "failed", "blocked", "not-run"] },
        "durationMilliseconds": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 300000 }, { "type": "null" }] },
        "packetFingerprint": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "answerFingerprint": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "useful": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
        "allAcceptedTechnicalClaimsCited": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
        "unauthorizedDisclosure": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
        "limitation": { "oneOf": [{ "type": "string", "maxLength": 512 }, { "type": "null" }] }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
