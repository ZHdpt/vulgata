{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vulgata:schema:business-logic:flow-v1",
  "title": "Vulgata bounded endpoint-centered Business Logic Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaIdentity",
    "binding",
    "title",
    "summary",
    "participants",
    "flowSteps",
    "businessRules",
    "dataMovements",
    "failurePaths",
    "unresolvedStatements"
  ],
  "properties": {
    "schemaIdentity": { "const": "business-logic/flow-v1" },
    "binding": { "$ref": "#/$defs/binding" },
    "title": { "$ref": "#/$defs/shortText" },
    "summary": { "$ref": "#/$defs/claim" },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/participant" }
    },
    "flowSteps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/flowStep" }
    },
    "businessRules": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/businessRule" }
    },
    "dataMovements": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/dataMovement" }
    },
    "failurePaths": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/failurePath" }
    },
    "unresolvedStatements": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/unresolvedStatement" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F-\\u009F]+$"
    },
    "shortText": {
      "allOf": [
        { "$ref": "#/$defs/boundedText" },
        { "maxLength": 256 }
      ]
    },
    "evidenceHandle": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "evidenceHandleRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceHandle" }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "pass2ExecutionId",
        "flowGroupId",
        "systemId",
        "consumerRepositoryId",
        "providerRepositoryId",
        "protocol",
        "normalizedEndpointIdentifierFingerprint",
        "consumerEntryStableKey",
        "logicalKeySchemaIdentity",
        "logicalDocumentStableKey",
        "exactResolutionDecisionId",
        "exactResolutionDecisionFingerprint",
        "exactResolutionEdgeId",
        "providerEvidenceFingerprint",
        "planFingerprint",
        "membershipFingerprint",
        "promptIdentity",
        "submissionSchemaIdentity"
      ],
      "properties": {
        "jobId": { "$ref": "#/$defs/uuid" },
        "pass2ExecutionId": { "$ref": "#/$defs/uuid" },
        "flowGroupId": { "$ref": "#/$defs/uuid" },
        "systemId": { "$ref": "#/$defs/uuid" },
        "consumerRepositoryId": { "$ref": "#/$defs/uuid" },
        "providerRepositoryId": { "$ref": "#/$defs/uuid" },
        "protocol": { "enum": ["CustomRpc", "Http"] },
        "normalizedEndpointIdentifierFingerprint": { "$ref": "#/$defs/sha256" },
        "consumerEntryStableKey": { "$ref": "#/$defs/sha256" },
        "logicalKeySchemaIdentity": { "const": "business-flow-logical-key/1.0" },
        "logicalDocumentStableKey": {
          "type": "string",
          "pattern": "^business-flow/v1/[0-9a-f]{64}$"
        },
        "exactResolutionDecisionId": { "$ref": "#/$defs/uuid" },
        "exactResolutionDecisionFingerprint": { "$ref": "#/$defs/sha256" },
        "exactResolutionEdgeId": { "$ref": "#/$defs/uuid" },
        "providerEvidenceFingerprint": { "$ref": "#/$defs/sha256" },
        "planFingerprint": { "$ref": "#/$defs/sha256" },
        "membershipFingerprint": { "$ref": "#/$defs/sha256" },
        "promptIdentity": { "$ref": "#/$defs/shortText" },
        "submissionSchemaIdentity": { "const": "business-logic/flow-v1" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "evidenceHandleRefs"],
      "properties": {
        "description": { "$ref": "#/$defs/boundedText" },
        "evidenceHandleRefs": { "$ref": "#/$defs/evidenceHandleRefs" }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "role", "name", "responsibility", "evidenceHandleRefs"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 16 },
        "role": { "enum": ["Consumer", "Provider", "Supporting"] },
        "name": { "$ref": "#/$defs/shortText" },
        "responsibility": { "$ref": "#/$defs/boundedText" },
        "evidenceHandleRefs": { "$ref": "#/$defs/evidenceHandleRefs" }
      }
    },
    "flowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "actor",
        "action",
        "outcome",
        "relationshipKind",
        "evidenceHandleRefs"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 32 },
        "actor": { "$ref": "#/$defs/shortText" },
        "action": { "$ref": "#/$defs/boundedText" },
        "outcome": { "$ref": "#/$defs/boundedText" },
        "relationshipKind": { "enum": ["Internal", "References"] },
        "evidenceHandleRefs": { "$ref": "#/$defs/evidenceHandleRefs" }
      }
    },
    "businessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "condition", "effect", "evidenceHandleRefs"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 32 },
        "condition": { "$ref": "#/$defs/boundedText" },
        "effect": { "$ref": "#/$defs/boundedText" },
        "evidenceHandleRefs": { "$ref": "#/$defs/evidenceHandleRefs" }
      }
    },
    "dataMovement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "from", "to", "value", "description", "evidenceHandleRefs"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 32 },
        "from": { "$ref": "#/$defs/shortText" },
        "to": { "$ref": "#/$defs/shortText" },
        "value": { "$ref": "#/$defs/shortText" },
        "description": { "$ref": "#/$defs/boundedText" },
        "evidenceHandleRefs": { "$ref": "#/$defs/evidenceHandleRefs" }
      }
    },
    "failurePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "trigger", "behavior", "businessImpact", "evidenceHandleRefs"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 32 },
        "trigger": { "$ref": "#/$defs/boundedText" },
        "behavior": { "$ref": "#/$defs/boundedText" },
        "businessImpact": { "$ref": "#/$defs/boundedText" },
        "evidenceHandleRefs": { "$ref": "#/$defs/evidenceHandleRefs" }
      }
    },
    "unresolvedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "status", "description", "evidenceHandleRefs"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 32 },
        "status": { "const": "Unresolved" },
        "description": { "$ref": "#/$defs/boundedText" },
        "evidenceHandleRefs": { "$ref": "#/$defs/evidenceHandleRefs" }
      }
    }
  }
}
