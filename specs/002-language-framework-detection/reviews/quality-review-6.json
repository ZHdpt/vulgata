  "findings": [
    {
      "id": "QR6-001",
      "severity": "HIGH",
      "category": "correctness-security-evidence-integrity",
      "artifact": "src/dotnet/Vulgata.Infrastructure/FrameworkDetection/FrameworkEvidenceDetector.cs",
      "location": "InventoryTrackedPathsAsync and ReadTrackedTextAsync, lines 439-590",
      "affected_requirement": "Story 4.2 AC-3 and AC-4; FR-008, FR-011, FR-012, FR-015, FR-021; committed-manifest and committed-lock contract; Constitution V data stewardship",
      "evidence": "The detector uses git ls-files --cached only to establish that a path is tracked, then reads that path through FileStream from the mutable working tree. A dirty tracked package.json, .csproj, requirements.txt, packages.lock.json, or package-lock.json can therefore create High/Medium framework facts from bytes absent from the committed Repository state. The check/read split also permits replacement after inventory or reparse validation. Existing tests cover untracked and ignored files but not dirty tracked or between-inventory-and-read mutation.",
      "correction_outcome": "Add behavior-level RED tests for dirty tracked direct manifests and lock files, including deterministic mutation between inventory and read. Bind parsed bytes to an immutable committed Git blob or fail closed, then rerun focused and surrounding tests and regenerate both Full review axes and all downstream candidate evidence."
    }
  ],
