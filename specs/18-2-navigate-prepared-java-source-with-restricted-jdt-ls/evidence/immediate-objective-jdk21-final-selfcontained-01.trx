      SELECT "Id", "ApprovalMessage", "ApprovedAt", "ConfirmedCommunicationKinds", "ContextContentHash", "ContextSnapshotId", "EvidenceTruncated", "Fingerprint", "HandoffSchemaIdentity", "PairPackageFingerprint", "PreparedScanContextIdentityHash", "PreparedScanManifestFingerprint", "PreparedScanManifestId", "ProfiledRevision", "RepositoryId", "ScanRunId", "SchemaVersion", "State", "TotalConfirmedEvidenceCount", "TotalHintCount", "TotalWarningCount"&#xD;
