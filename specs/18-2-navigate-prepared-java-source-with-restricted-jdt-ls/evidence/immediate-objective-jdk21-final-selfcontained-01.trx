          CONSTRAINT "CK_Pass2Executions_Accounting" CHECK ("CandidateCount" BETWEEN 0 AND 256 AND length("ResolutionFingerprint") = 64 AND length("PlanningFingerprint") = 64 AND length("ExecutionFingerprint") = 64 AND "PublishedCount" &gt;= 0 AND "FailedCount" &gt;= 0 AND "PlannedCount" BETWEEN 0 AND 256 AND "TerminalIncompleteCount" &gt;= 0 AND "TerminalBoundExcludedCount" &gt;= 0 AND "TerminalOmissionCount" &gt;= 0),&#xD;
