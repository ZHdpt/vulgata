          CONSTRAINT "FK_TwoRepositoryScanCoordinations_ScanRuns_ScanRunOneId_Reposi~" FOREIGN KEY ("ScanRunOneId", "RepositoryOneId") REFERENCES "ScanRuns" ("Id", "RepositoryId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_TwoRepositoryScanCoordinations_ScanRuns_ScanRunTwoId_Reposi~" FOREIGN KEY ("ScanRunTwoId", "RepositoryTwoId") REFERENCES "ScanRuns" ("Id", "RepositoryId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_TwoRepositoryScanCoordinations_Systems_SystemId" FOREIGN KEY ("SystemId") REFERENCES "Systems" ("Id") ON DELETE RESTRICT&#xD;
      );&#xD;
