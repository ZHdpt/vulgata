          CONSTRAINT "CK_Pass2RetrievalResults_Coordinates" CHECK (("Kind" = 'Document' AND "SectionId" IS NULL AND "SourceAnchorId" IS NULL AND "EdgeId" IS NULL AND "ByteStart" IS NULL AND "ByteEnd" IS NULL) OR ("Kind" = 'Section' AND "SectionId" IS NOT NULL AND "SourceAnchorId" IS NULL AND "EdgeId" IS NULL AND "ByteStart" IS NULL AND "ByteEnd" IS NULL) OR ("Kind" = 'SourceAnchor' AND "SectionId" IS NULL AND "SourceAnchorId" IS NOT NULL AND "EdgeId" IS NULL AND "ByteStart" IS NULL AND "ByteEnd" IS NULL) OR ("Kind" = 'SourceExcerpt' AND "SectionId" IS NULL AND "SourceAnchorId" IS NOT NULL AND "EdgeId" IS NULL AND "ByteStart" &gt;= 0 AND "ByteEnd" &gt; "ByteStart") OR ("Kind" = 'Relationship' AND "SectionId" IS NULL AND "SourceAnchorId" IS NULL AND "EdgeId" IS NOT NULL AND "ByteStart" IS NULL AND "ByteEnd" IS NULL)),&#xD;
