          CONSTRAINT "CK_TwoRepositoryScanCoordinations_Phase_Closed" CHECK ("Phase" IN ('Preparing', 'Pass1', 'Resolving', 'Pass2', 'Paused', 'Completed', 'CompletedWithWarnings', 'FailedIntegrity', 'FailedSecurity', 'Cancelled', 'FailedPass1')),&#xD;
          CONSTRAINT "CK_TwoRepositoryScanCoordinations_ReasonCategory_Closed" CHECK ("ReasonCategory" IS NULL OR "ReasonCategory" IN ('ProviderUnavailable', 'OperatorCorrection', 'Integrity', 'Security', 'Cancellation', 'Unclassified', 'Pass1Policy')),&#xD;
          CONSTRAINT "CK_TwoRepositoryScanCoordinations_Repositories_Distinct" CHECK ("RepositoryOneId" &lt;&gt; "RepositoryTwoId"),&#xD;
