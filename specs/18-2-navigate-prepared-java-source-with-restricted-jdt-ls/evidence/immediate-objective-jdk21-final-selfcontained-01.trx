          "SystemId" uuid NOT NULL,&#xD;
          "TerminalAt" timestamp with time zone NULL,&#xD;
          "TerminalMessage" character varying(512) NULL,&#xD;
          "TerminalReasonKind" character varying(32) NULL,&#xD;
          "TotalJobCount" integer NOT NULL,&#xD;
          "UpdatedAt" timestamp with time zone NULL,&#xD;
          CONSTRAINT "AK_ScanExecutions_Id_RepositoryId" UNIQUE ("Id", "RepositoryId"),&#xD;
          CONSTRAINT "AK_ScanExecutions_ScanRunId_RepositoryId" UNIQUE ("ScanRunId", "RepositoryId"),&#xD;
          CONSTRAINT "CK_ScanExecutions_NewPathBinding_Shape" CHECK (("Phase" IN ('Pass1Planning', 'Pass1Running', 'Pass1Completed', 'Failed') AND "PromptIdentity" IS NULL AND "DocumentSchemaIdentity" IS NULL AND "AnalysisRuntimeIdentityJson" IS NULL AND "AnalysisRuntimeIdentityHash" IS NULL AND "UpdatedAt" IS NULL) OR ("Phase" IN ('Prepared', 'Running', 'PausedProviderUnavailable', 'PausedOperatorCorrection', 'CompletedWithWarnings', 'FailedIntegrity', 'FailedSecurity') AND "PromptIdentity" IS NOT NULL AND "DocumentSchemaIdentity" IS NOT NULL AND "AnalysisRuntimeIdentityJson" IS NOT NULL AND "AnalysisRuntimeIdentityHash" IS NOT NULL AND "UpdatedAt" IS NOT NULL) OR ("Phase" IN ('Completed', 'Cancelled') AND (("PromptIdentity" IS NULL AND "DocumentSchemaIdentity" IS NULL AND "AnalysisRuntimeIdentityJson" IS NULL AND "AnalysisRuntimeIdentityHash" IS NULL AND "UpdatedAt" IS NULL) OR ("PromptIdentity" IS NOT NULL AND "DocumentSchemaIdentity" IS NOT NULL AND "AnalysisRuntimeIdentityJson" IS NOT NULL AND "AnalysisRuntimeIdentityHash" IS NOT NULL AND "UpdatedAt" IS NOT NULL)))),&#xD;
          CONSTRAINT "CK_ScanExecutions_PauseFailure_Shape" CHECK (("Phase" = 'PausedProviderUnavailable' AND "PauseCategory" = 'ProviderUnavailable' AND "PauseCode" IS NOT NULL AND "FailureCategory" IS NULL AND "FailureCode" IS NULL) OR ("Phase" = 'PausedOperatorCorrection' AND "PauseCategory" = 'OperatorCorrection' AND "PauseCode" IS NOT NULL AND "FailureCategory" IS NULL AND "FailureCode" IS NULL) OR ("Phase" = 'FailedIntegrity' AND "PauseCategory" IS NULL AND "PauseCode" IS NULL AND "FailureCategory" = 'Integrity' AND "FailureCode" IS NOT NULL) OR ("Phase" = 'FailedSecurity' AND "PauseCategory" IS NULL AND "PauseCode" IS NULL AND "FailureCategory" = 'Security' AND "FailureCode" IS NOT NULL) OR ("Phase" NOT IN ('PausedProviderUnavailable', 'PausedOperatorCorrection', 'FailedIntegrity', 'FailedSecurity') AND "PauseCategory" IS NULL AND "PauseCode" IS NULL AND (("FailureCategory" IS NULL AND "FailureCode" IS NULL) OR ("Phase" = 'Cancelled' AND "FailureCategory" = 'Cancellation' AND "FailureCode" IS NOT NULL)))),&#xD;
          CONSTRAINT "CK_ScanExecutions_Phase_Closed" CHECK ("Phase" IN ('Pass1Planning', 'Pass1Running', 'Pass1Completed', 'Completed', 'Failed', 'Cancelled', 'Prepared', 'Running', 'PausedProviderUnavailable', 'PausedOperatorCorrection', 'CompletedWithWarnings', 'FailedIntegrity', 'FailedSecurity')),&#xD;
          CONSTRAINT "CK_ScanExecutions_RestartIndicator_Bound" CHECK (0 &lt;= "RestartIndicator" AND "RestartIndicator" &lt;= 32),&#xD;
          CONSTRAINT "CK_ScanExecutions_StateVersion_Bound" CHECK ("StateVersion" &gt;= 0),&#xD;
          CONSTRAINT "CK_ScanExecutions_TerminalReasonKind_Closed" CHECK ("TerminalReasonKind" IS NULL OR "TerminalReasonKind" IN ('SchemaInvalid', 'Error', 'Unbounded', 'MissingPrerequisite', 'DuplicateActiveScan', 'MissingCodeUnit', 'ForbiddenContent', 'OverLimitPacket')),&#xD;
          CONSTRAINT "FK_ScanExecutions_Repositories_RepositoryId" FOREIGN KEY ("RepositoryId") REFERENCES "Repositories" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_ScanExecutions_ScanRuns_ScanRunId_RepositoryId" FOREIGN KEY ("ScanRunId", "RepositoryId") REFERENCES "ScanRuns" ("Id", "RepositoryId") ON DELETE RESTRICT&#xD;
      );&#xD;
