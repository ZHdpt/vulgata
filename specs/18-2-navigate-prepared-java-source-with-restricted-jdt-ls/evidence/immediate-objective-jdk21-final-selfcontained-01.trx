          CONSTRAINT "FK_DocumentVersions_DocumentVersions_SupersededById_LogicalDoc~" FOREIGN KEY ("SupersededById", "LogicalDocumentId", "RepositoryId") REFERENCES "DocumentVersions" ("Id", "LogicalDocumentId", "RepositoryId") ON DELETE RESTRICT,&#xD;
