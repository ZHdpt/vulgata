          "CompletedJobCount" integer NOT NULL,&#xD;
          "DocumentSchemaIdentity" character varying(128) NULL,&#xD;
          "FailureCategory" character varying(32) NULL,&#xD;
          "FailureCode" character varying(64) NULL,&#xD;
