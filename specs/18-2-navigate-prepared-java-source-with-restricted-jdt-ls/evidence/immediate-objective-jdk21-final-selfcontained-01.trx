          "ReasonCode" character varying(64) NULL,&#xD;
          "RepositoryId" uuid NOT NULL,&#xD;
          "ScanRunId" uuid NOT NULL,&#xD;
          "SchemaIdentity" character varying(128) NULL,&#xD;
          "State" character varying(32) NOT NULL,&#xD;
          "SystemId" uuid NULL,&#xD;
          "Title" character varying(4096) NOT NULL,&#xD;
          CONSTRAINT "CK_FlowGroups_Fingerprint_Lengths" CHECK (("PlanFingerprint" = '' OR length("PlanFingerprint") = 64) AND ("MembershipFingerprint" IS NULL OR length("MembershipFingerprint") = 64) AND ("ConsumerEntryStableKey" IS NULL OR length("ConsumerEntryStableKey") = 64)),&#xD;
          CONSTRAINT "CK_FlowGroups_GroupOrder_Positive" CHECK ("GroupOrder" &gt; 0),&#xD;
          CONSTRAINT "CK_FlowGroups_LogicalKeySchemaIdentity_Closed" CHECK ("LogicalKeySchemaIdentity" IS NULL OR "LogicalKeySchemaIdentity" = 'business-flow-logical-key/1.0'),&#xD;
          CONSTRAINT "CK_FlowGroups_Protocol_Closed" CHECK ("Protocol" IS NULL OR "Protocol" IN ('CustomRpc', 'Http')),&#xD;
          CONSTRAINT "CK_FlowGroups_ProviderRepository_CrossRepository" CHECK ("ProviderRepositoryId" IS NULL OR "ProviderRepositoryId" &lt;&gt; "RepositoryId"),&#xD;
          CONSTRAINT "CK_FlowGroups_SchemaIdentity_Closed" CHECK ("SchemaIdentity" IS NULL OR "SchemaIdentity" = 'endpoint-flow-group/1.0'),&#xD;
          CONSTRAINT "CK_FlowGroups_State_Closed" CHECK ("SchemaIdentity" IS NULL OR "State" IN ('Complete', 'Incomplete', 'BoundExcluded', 'Running', 'Published', 'Failed')),&#xD;
          CONSTRAINT "FK_FlowGroups_CrossRepositoryResolutionDecisions_ExactResoluti~" FOREIGN KEY ("ExactResolutionDecisionId") REFERENCES "CrossRepositoryResolutionDecisions" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_FlowGroups_DocumentEdges_ExactResolutionEdgeId" FOREIGN KEY ("ExactResolutionEdgeId") REFERENCES "DocumentEdges" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_FlowGroups_DocumentVersions_BusinessLogicDocumentVersionId_~" FOREIGN KEY ("BusinessLogicDocumentVersionId", "RepositoryId", "ScanRunId") REFERENCES "DocumentVersions" ("Id", "RepositoryId", "ScanRunId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_FlowGroups_DocumentVersions_ConsumerDocumentVersionId_Repos~" FOREIGN KEY ("ConsumerDocumentVersionId", "RepositoryId", "ScanRunId") REFERENCES "DocumentVersions" ("Id", "RepositoryId", "ScanRunId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_FlowGroups_DocumentVersions_ProviderImplementationDocumentV~" FOREIGN KEY ("ProviderImplementationDocumentVersionId") REFERENCES "DocumentVersions" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_FlowGroups_DocumentVersions_ProviderXmlDocumentVersionId" FOREIGN KEY ("ProviderXmlDocumentVersionId") REFERENCES "DocumentVersions" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_FlowGroups_Pass2Executions_Pass2ExecutionId" FOREIGN KEY ("Pass2ExecutionId") REFERENCES "Pass2Executions" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_FlowGroups_Repositories_ProviderRepositoryId" FOREIGN KEY ("ProviderRepositoryId") REFERENCES "Repositories" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_FlowGroups_Systems_SystemId" FOREIGN KEY ("SystemId") REFERENCES "Systems" ("Id") ON DELETE RESTRICT&#xD;
      );&#xD;
