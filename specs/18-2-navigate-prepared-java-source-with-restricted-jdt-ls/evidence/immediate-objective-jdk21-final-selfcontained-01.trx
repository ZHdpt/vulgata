          CONSTRAINT "CK_PreparedScanAudits_Measurements" CHECK (("RawByteCount" IS NULL OR "RawByteCount" &gt;= 0) AND ("LogicalLineCount" IS NULL OR "LogicalLineCount" &gt;= 0)),&#xD;
