          "LogicalDocumentStableKey" character varying(512) NOT NULL,&#xD;
          "LogicalKeySchemaIdentity" character varying(128) NULL,&#xD;
          "MembershipFingerprint" character(64) NULL,&#xD;
          "NormalizedEndpointIdentifier" character varying(512) NULL,&#xD;
          "Pass2ExecutionId" uuid NULL,&#xD;
          "PlanFingerprint" character(64) NOT NULL,&#xD;
          "Protocol" character varying(32) NULL,&#xD;
          "ProviderImplementationDocumentVersionId" uuid NULL,&#xD;
          "ProviderRepositoryId" uuid NULL,&#xD;
