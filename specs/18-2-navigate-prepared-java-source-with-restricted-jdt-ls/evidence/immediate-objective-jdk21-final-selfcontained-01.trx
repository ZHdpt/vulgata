          CONSTRAINT "CK_ScanExecutions_NewPathBinding_Shape" CHECK (("Phase" IN ('Pass1Planning', 'Pass1Running', 'Pass1Completed', 'Failed') AND "PromptIdentity" IS NULL AND "DocumentSchemaIdentity" IS NULL AND "AnalysisRuntimeIdentityJson" IS NULL AND "AnalysisRuntimeIdentityHash" IS NULL AND "UpdatedAt" IS NULL) OR ("Phase" IN ('Prepared', 'Running', 'PausedProviderUnavailable', 'PausedOperatorCorrection', 'CompletedWithWarnings', 'FailedIntegrity', 'FailedSecurity') AND "PromptIdentity" IS NOT NULL AND "DocumentSchemaIdentity" IS NOT NULL AND "AnalysisRuntimeIdentityJson" IS NOT NULL AND "AnalysisRuntimeIdentityHash" IS NOT NULL AND "UpdatedAt" IS NOT NULL) OR ("Phase" IN ('Completed', 'Cancelled') AND (("PromptIdentity" IS NULL AND "DocumentSchemaIdentity" IS NULL AND "AnalysisRuntimeIdentityJson" IS NULL AND "AnalysisRuntimeIdentityHash" IS NULL AND "UpdatedAt" IS NULL) OR ("PromptIdentity" IS NOT NULL AND "DocumentSchemaIdentity" IS NOT NULL AND "AnalysisRuntimeIdentityJson" IS NOT NULL AND "AnalysisRuntimeIdentityHash" IS NOT NULL AND "UpdatedAt" IS NOT NULL)))),&#xD;
