          CONSTRAINT "FK_DocumentVersions_ScanRuns_ScanRunId_RepositoryId" FOREIGN KEY ("ScanRunId", "RepositoryId") REFERENCES "ScanRuns" ("Id", "RepositoryId") ON DELETE RESTRICT&#xD;
      );&#xD;
