          CONSTRAINT "FK_PreScanResults_ScanRuns_Id_RepositoryId" FOREIGN KEY ("Id", "RepositoryId") REFERENCES "ScanRuns" ("Id", "RepositoryId") ON DELETE CASCADE&#xD;
