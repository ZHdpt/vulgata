          CONSTRAINT "CK_TwoRepositoryScanCoordinations_StateVersion_Bound" CHECK ("StateVersion" &gt;= 0),&#xD;
          CONSTRAINT "CK_TwoRepositoryScanCoordinations_TerminalReason_Shape" CHECK (("Phase" IN ('Completed', 'CompletedWithWarnings') AND "TerminalAt" IS NOT NULL AND "ReasonCategory" IS NULL AND "ReasonCode" IS NULL) OR ("Phase" IN ('FailedIntegrity', 'FailedSecurity', 'Cancelled', 'FailedPass1') AND "TerminalAt" IS NOT NULL AND "ReasonCategory" IS NOT NULL AND "ReasonCode" IS NOT NULL) OR ("Phase" = 'Paused' AND "TerminalAt" IS NULL AND "ReasonCategory" IS NOT NULL AND "ReasonCode" IS NOT NULL) OR ("Phase" IN ('Preparing', 'Pass1', 'Resolving', 'Pass2') AND "TerminalAt" IS NULL AND "ReasonCategory" IS NULL AND "ReasonCode" IS NULL)),&#xD;
          CONSTRAINT "FK_TwoRepositoryScanCoordinations_Repositories_RepositoryOneId" FOREIGN KEY ("RepositoryOneId") REFERENCES "Repositories" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_TwoRepositoryScanCoordinations_Repositories_RepositoryTwoId" FOREIGN KEY ("RepositoryTwoId") REFERENCES "Repositories" ("Id") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_TwoRepositoryScanCoordinations_ScanExecutions_ScanExecution~" FOREIGN KEY ("ScanExecutionOneId", "RepositoryOneId") REFERENCES "ScanExecutions" ("Id", "RepositoryId") ON DELETE RESTRICT,&#xD;
