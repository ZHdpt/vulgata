          "PreScanResultId" uuid NOT NULL,&#xD;
          "Provenance" character varying(32) NOT NULL,&#xD;
          "RelativePath" character varying(2048) NOT NULL,&#xD;
          "Rule" character varying(64) NOT NULL,&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_CatalogRuleIdentity_Length" CHECK ("CatalogRuleIdentity" IS NULL OR length("CatalogRuleIdentity") BETWEEN 1 AND 256),&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_Compatibility" CHECK (("Rule" = 'RpcDirectAnnotation' AND "Kind" = 'Rpc' AND "Level" = 'Confirmed' AND "Confidence" = 'High' AND "Provenance" = 'StructuralAnnotation') OR ("Rule" = 'RpcMatchedConfiguration' AND "Kind" = 'Rpc' AND "Level" = 'Confirmed' AND "Confidence" = 'High' AND "Provenance" = 'MatchedConfiguration') OR ("Rule" IN ('HttpControllerAnnotation', 'HttpClientAnnotation') AND "Kind" = 'Http' AND "Level" = 'Confirmed' AND "Confidence" = 'High' AND "Provenance" = 'StructuralAnnotation') OR ("Rule" = 'HttpMatchedConfiguration' AND "Kind" = 'Http' AND "Level" = 'Confirmed' AND "Confidence" = 'High' AND "Provenance" = 'MatchedConfiguration') OR ("Rule" = 'RpcImportOnly' AND "Kind" = 'Rpc' AND "Level" = 'Hint' AND "Confidence" = 'Conservative' AND "Provenance" IN ('Import', 'PackageManifest', 'FrameworkFact')) OR ("Rule" = 'HttpImportOnly' AND "Kind" = 'Http' AND "Level" = 'Hint' AND "Confidence" = 'Conservative' AND "Provenance" IN ('Import', 'PackageManifest', 'FrameworkFact')) OR ("Rule" IN ('MalformedEvidence', 'UnsafePath', 'BoundExceeded', 'ContradictoryEvidence') AND "Level" = 'Warning' AND "Confidence" = 'None' AND "Provenance" = 'Detector') OR ("Rule" = 'UnsupportedFamily' AND "Kind" IS NULL AND "Level" = 'Warning' AND "Confidence" = 'None' AND "Provenance" = 'Detector')),&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_Confidence" CHECK ("Confidence" IN ('High', 'Conservative', 'None')),&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_Fingerprint_Length" CHECK (length("Fingerprint") = 64),&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_Kind" CHECK ("Kind" IS NULL OR "Kind" IN ('Rpc', 'Http')),&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_Level" CHECK ("Level" IN ('Confirmed', 'Hint', 'Warning')),&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_LevelConfidence" CHECK (("Level" = 'Confirmed' AND "Confidence" = 'High' AND "Kind" IS NOT NULL) OR ("Level" = 'Hint' AND "Confidence" = 'Conservative' AND "Kind" IS NOT NULL) OR ("Level" = 'Warning' AND "Confidence" = 'None')),&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_OccurrenceCount" CHECK ("OccurrenceCount" BETWEEN 1 AND 250000),&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_PathLocator" CHECK (length("RelativePath") BETWEEN 1 AND 2048 AND length("Locator") BETWEEN 1 AND 4096),&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_Provenance" CHECK ("Provenance" IN ('StructuralAnnotation', 'FrameworkFact', 'PackageManifest', 'MatchedConfiguration', 'Import', 'Detector')),&#xD;
          CONSTRAINT "CK_CommunicationKindClassifications_Rule" CHECK ("Rule" IN ('RpcDirectAnnotation', 'RpcMatchedConfiguration', 'HttpControllerAnnotation', 'HttpClientAnnotation', 'HttpMatchedConfiguration', 'RpcImportOnly', 'HttpImportOnly', 'MalformedEvidence', 'UnsafePath', 'BoundExceeded', 'ContradictoryEvidence', 'UnsupportedFamily')),&#xD;
          CONSTRAINT "FK_CommunicationKindClassifications_PreScanResults_PreScanResu~" FOREIGN KEY ("PreScanResultId") REFERENCES "PreScanResults" ("Id") ON DELETE CASCADE&#xD;
      );&#xD;
