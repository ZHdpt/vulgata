      CREATE TABLE "ef_temp_ScanExecutions" (&#xD;
          "Id" uuid NOT NULL CONSTRAINT "PK_ScanExecutions" PRIMARY KEY,&#xD;
          "AnalysisRuntimeIdentityHash" character(64) NULL,&#xD;
