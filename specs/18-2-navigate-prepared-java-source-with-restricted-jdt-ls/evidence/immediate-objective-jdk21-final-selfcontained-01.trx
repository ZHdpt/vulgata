          CONSTRAINT "CK_TwoRepositoryScanCoordinations_ReasonCategory_Closed" CHECK ("ReasonCategory" IS NULL OR "ReasonCategory" IN ('ProviderUnavailable', 'OperatorCorrection', 'Integrity', 'Security', 'Cancellation', 'Unclassified', 'Pass1Policy')),&#xD;
