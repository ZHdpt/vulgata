      CREATE TABLE "Pass2Executions" (&#xD;
          "Id" uuid NOT NULL CONSTRAINT "PK_Pass2Executions" PRIMARY KEY,&#xD;
          "Pass1PairExecutionId" uuid NOT NULL,&#xD;
          "CoordinationId" uuid NOT NULL,&#xD;
          "SystemId" uuid NOT NULL,&#xD;
          "AuthorizationSubject" character varying(450) NOT NULL,&#xD;
          "WorkerPromptIdentity" character varying(128) NOT NULL,&#xD;
          "WorkerPromptFingerprint" character(64) NOT NULL,&#xD;
          "SubmissionSchemaIdentity" character varying(128) NOT NULL,&#xD;
          "SubmissionSchemaFingerprint" character(64) NOT NULL,&#xD;
          "ToolDeclarationFingerprint" character(64) NOT NULL,&#xD;
          "CandidateCount" integer NOT NULL,&#xD;
          "ResolutionFingerprint" character(64) NOT NULL,&#xD;
          "PlanningFingerprint" character(64) NOT NULL,&#xD;
          "ExecutionFingerprint" character(64) NOT NULL,&#xD;
          "State" character varying(64) NOT NULL,&#xD;
          "PublishedCount" integer NOT NULL,&#xD;
          "FailedCount" integer NOT NULL,&#xD;
          "PlannedCount" integer NOT NULL,&#xD;
          "PlanRecorded" boolean NOT NULL,&#xD;
          "TerminalIncompleteCount" integer NOT NULL,&#xD;
          "TerminalBoundExcludedCount" integer NOT NULL,&#xD;
          "TerminalOmissionCount" integer NOT NULL,&#xD;
          "TerminalWarningInventory" character varying(65536) NULL,&#xD;
          "StateVersion" bigint NOT NULL,&#xD;
          "StartedAt" timestamp with time zone NOT NULL,&#xD;
          "UpdatedAt" timestamp with time zone NOT NULL,&#xD;
          CONSTRAINT "CK_Pass2Executions_Accounting" CHECK ("CandidateCount" BETWEEN 0 AND 256 AND length("ResolutionFingerprint") = 64 AND length("PlanningFingerprint") = 64 AND length("ExecutionFingerprint") = 64 AND "PublishedCount" &gt;= 0 AND "FailedCount" &gt;= 0 AND "PlannedCount" BETWEEN 0 AND 256 AND "TerminalIncompleteCount" &gt;= 0 AND "TerminalBoundExcludedCount" &gt;= 0 AND "TerminalOmissionCount" &gt;= 0),&#xD;
          CONSTRAINT "CK_Pass2Executions_AcceptedWorkerContract" CHECK (length("WorkerPromptIdentity") BETWEEN 1 AND 128 AND length("WorkerPromptFingerprint") = 64 AND length("SubmissionSchemaIdentity") BETWEEN 1 AND 128 AND length("SubmissionSchemaFingerprint") = 64 AND length("ToolDeclarationFingerprint") = 64),&#xD;
          CONSTRAINT "CK_Pass2Executions_TerminalSummary" CHECK (("State" IN ('Completed', 'CompletedWithWarnings') AND "TerminalWarningInventory" IS NOT NULL) OR ("State" IN ('FailedIntegrity', 'FailedSecurity')) OR ("State" NOT IN ('Completed', 'CompletedWithWarnings', 'FailedIntegrity', 'FailedSecurity') AND "TerminalWarningInventory" IS NULL AND "TerminalIncompleteCount" = 0 AND "TerminalBoundExcludedCount" = 0 AND "TerminalOmissionCount" = 0)),&#xD;
          CONSTRAINT "FK_Pass2Executions_Pass1PairExecutions_Pass1PairExecutionId" FOREIGN KEY ("Pass1PairExecutionId") REFERENCES "Pass1PairExecutions" ("Id") ON DELETE RESTRICT,&#xD;
