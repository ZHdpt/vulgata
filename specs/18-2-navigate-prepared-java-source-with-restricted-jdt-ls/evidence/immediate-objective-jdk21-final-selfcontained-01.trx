          CONSTRAINT "CK_ScanExecutions_PauseFailure_Shape" CHECK (("Phase" = 'PausedProviderUnavailable' AND "PauseCategory" = 'ProviderUnavailable' AND "PauseCode" IS NOT NULL AND "FailureCategory" IS NULL AND "FailureCode" IS NULL) OR ("Phase" = 'PausedOperatorCorrection' AND "PauseCategory" = 'OperatorCorrection' AND "PauseCode" IS NOT NULL AND "FailureCategory" IS NULL AND "FailureCode" IS NULL) OR ("Phase" = 'FailedIntegrity' AND "PauseCategory" IS NULL AND "PauseCode" IS NULL AND "FailureCategory" = 'Integrity' AND "FailureCode" IS NOT NULL) OR ("Phase" = 'FailedSecurity' AND "PauseCategory" IS NULL AND "PauseCode" IS NULL AND "FailureCategory" = 'Security' AND "FailureCode" IS NOT NULL) OR ("Phase" NOT IN ('PausedProviderUnavailable', 'PausedOperatorCorrection', 'FailedIntegrity', 'FailedSecurity') AND "PauseCategory" IS NULL AND "PauseCode" IS NULL AND (("FailureCategory" IS NULL AND "FailureCode" IS NULL) OR ("Phase" = 'Cancelled' AND "FailureCategory" = 'Cancellation' AND "FailureCode" IS NOT NULL)))),&#xD;
          CONSTRAINT "CK_ScanExecutions_Phase_Closed" CHECK ("Phase" IN ('Pass1Planning', 'Pass1Running', 'Pass1Completed', 'Completed', 'Failed', 'Cancelled', 'Prepared', 'Running', 'PausedProviderUnavailable', 'PausedOperatorCorrection', 'CompletedWithWarnings', 'FailedIntegrity', 'FailedSecurity')),&#xD;
          CONSTRAINT "CK_ScanExecutions_RestartIndicator_Bound" CHECK (0 &lt;= "RestartIndicator" AND "RestartIndicator" &lt;= 32),&#xD;
          CONSTRAINT "CK_ScanExecutions_StateVersion_Bound" CHECK ("StateVersion" &gt;= 0),&#xD;
          CONSTRAINT "CK_ScanExecutions_TerminalReasonKind_Closed" CHECK ("TerminalReasonKind" IS NULL OR "TerminalReasonKind" IN ('SchemaInvalid', 'Error', 'Unbounded', 'MissingPrerequisite', 'DuplicateActiveScan', 'MissingCodeUnit', 'ForbiddenContent', 'OverLimitPacket')),&#xD;
