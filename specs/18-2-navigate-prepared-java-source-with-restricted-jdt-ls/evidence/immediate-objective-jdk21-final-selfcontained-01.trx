      CREATE TABLE "ef_temp_PreScanResults" (&#xD;
          "Id" uuid NOT NULL CONSTRAINT "PK_PreScanResults" PRIMARY KEY,&#xD;
          "ApprovalMessage" character varying(256) NOT NULL,&#xD;
          "ApprovedAt" timestamp with time zone NOT NULL,&#xD;
          "ConfirmedCommunicationKinds" integer NOT NULL,&#xD;
          "ContextContentHash" character(64) NULL,&#xD;
          "ContextSnapshotId" uuid NULL,&#xD;
          "EvidenceTruncated" boolean NOT NULL,&#xD;
          "Fingerprint" character(64) NOT NULL,&#xD;
          "HandoffSchemaIdentity" character varying(128) NULL,&#xD;
          "PairPackageFingerprint" character(64) NULL,&#xD;
          "PreparedScanContextIdentityHash" character(64) NULL,&#xD;
          "PreparedScanManifestFingerprint" character(64) NULL,&#xD;
          "PreparedScanManifestId" uuid NULL,&#xD;
          "ProfiledRevision" character varying(64) NOT NULL,&#xD;
          "RepositoryId" uuid NOT NULL,&#xD;
          "ScanRunId" uuid NOT NULL,&#xD;
          "SchemaVersion" character varying(16) NOT NULL,&#xD;
          "State" character varying(32) NOT NULL,&#xD;
          "TotalConfirmedEvidenceCount" integer NOT NULL,&#xD;
          "TotalHintCount" integer NOT NULL,&#xD;
          "TotalWarningCount" integer NOT NULL,&#xD;
          CONSTRAINT "CK_PreScanResults_ApprovalMessage_Length" CHECK (length("ApprovalMessage") BETWEEN 1 AND 256),&#xD;
          CONSTRAINT "CK_PreScanResults_ConfirmedKinds" CHECK ("ConfirmedCommunicationKinds" BETWEEN 0 AND 3),&#xD;
          CONSTRAINT "CK_PreScanResults_Counts" CHECK ("TotalConfirmedEvidenceCount" BETWEEN 0 AND 250000 AND "TotalHintCount" BETWEEN 0 AND 250000 AND "TotalWarningCount" BETWEEN 0 AND 250000),&#xD;
          CONSTRAINT "CK_PreScanResults_Fingerprint_Length" CHECK (length("Fingerprint") = 64),&#xD;
          CONSTRAINT "CK_PreScanResults_Identity" CHECK ("Id" = "ScanRunId"),&#xD;
          CONSTRAINT "CK_PreScanResults_PreparedV2Shape" CHECK (("SchemaVersion" = '1.0' AND "PreparedScanManifestId" IS NULL AND "PreparedScanManifestFingerprint" IS NULL AND "ContextSnapshotId" IS NULL AND "PreparedScanContextIdentityHash" IS NULL AND "ContextContentHash" IS NULL AND "HandoffSchemaIdentity" IS NULL AND "PairPackageFingerprint" IS NULL) OR ("SchemaVersion" = '2.0' AND "PreparedScanManifestId" IS NOT NULL AND length("PreparedScanManifestFingerprint") = 64 AND "ContextSnapshotId" IS NOT NULL AND length("PreparedScanContextIdentityHash") = 64 AND length("ContextContentHash") = 64 AND "HandoffSchemaIdentity" = 'prepared-scan-handoff/2.0' AND length("PairPackageFingerprint") = 64)),&#xD;
          CONSTRAINT "CK_PreScanResults_ProfiledRevision_Length" CHECK (length("ProfiledRevision") BETWEEN 1 AND 64),&#xD;
          CONSTRAINT "CK_PreScanResults_SchemaVersion" CHECK ("SchemaVersion" IN ('1.0', '2.0')),&#xD;
          CONSTRAINT "CK_PreScanResults_State" CHECK ("State" = 'PreScanApproved'),&#xD;
          CONSTRAINT "FK_PreScanResults_PreparedScanManifests_PreparedScanManifestId~" FOREIGN KEY ("PreparedScanManifestId", "ScanRunId", "RepositoryId") REFERENCES "PreparedScanManifests" ("Id", "ScanRunId", "RepositoryId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_PreScanResults_ScanContextSnapshots_ContextSnapshotId_ScanR~" FOREIGN KEY ("ContextSnapshotId", "ScanRunId", "RepositoryId") REFERENCES "ScanContextSnapshots" ("Id", "ScanRunId", "RepositoryId") ON DELETE RESTRICT,&#xD;
          CONSTRAINT "FK_PreScanResults_ScanRuns_Id_RepositoryId" FOREIGN KEY ("Id", "RepositoryId") REFERENCES "ScanRuns" ("Id", "RepositoryId") ON DELETE CASCADE&#xD;
      );&#xD;
