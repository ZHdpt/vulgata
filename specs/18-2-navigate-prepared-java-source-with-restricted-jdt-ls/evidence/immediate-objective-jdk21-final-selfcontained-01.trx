          CONSTRAINT "AK_ScanContextSnapshots_Id_ScanRunId_RepositoryId" UNIQUE ("Id", "ScanRunId", "RepositoryId"),&#xD;
          CONSTRAINT "AK_ScanContextSnapshots_ScanRunId_RepositoryId" UNIQUE ("ScanRunId", "RepositoryId"),&#xD;
          CONSTRAINT "CK_ScanContextSnapshots_ContentHash_Length" CHECK (length("ContentHash") = 64),&#xD;
          CONSTRAINT "CK_ScanContextSnapshots_PreparedIdentityHash_Length" CHECK ("PreparedScanContextIdentityHash" IS NULL OR length("PreparedScanContextIdentityHash") = 64),&#xD;
          CONSTRAINT "CK_ScanContextSnapshots_SchemaIdentity_Closed" CHECK ("SchemaIdentity" = 'scan-context-snapshot/1.0'),&#xD;
          CONSTRAINT "FK_ScanContextSnapshots_Repositories_RepositoryId" FOREIGN KEY ("RepositoryId") REFERENCES "Repositories" ("Id") ON DELETE RESTRICT,&#xD;
